{
  "project_info": {
    "title": "FPGA-Accelerated Lane Detection with Confidence-Controlled Edge Thresholding",
    "target_hardware": "PYNQ-Z2 (Zynq-7000 XC7Z020)",
    "frame_width": 640,
    "frame_height": 360,
    "target_fps": 30
  },
  "preprocessing": {
    "gaussian_kernel_size": 5,
    "gaussian_sigma": 1.0,
    "sobel_kernel_size": 3,
    "fixed_edge_threshold": 50,
    "adaptive_threshold_min": 25,
    "adaptive_threshold_max": 120
  },
  "roi": {
    "polygon_normalized": [
      [0.10, 0.95],
      [0.42, 0.60],
      [0.58, 0.60],
      [0.90, 0.95]
    ]
  },
  "confidence_score": {
    "weights": {
      "coverage": 0.40,
      "edge_strength": 0.35,
      "geometric_fit": 0.25
    },
    "bands": {
      "high": 0.70,
      "medium": 0.45,
      "low": 0.0
    }
  },
  "virtual_lane": {
    "persistence_frames_trigger": 5,
    "seed_box_width_ratio": 0.20,
    "seed_box_height_ratio": 0.10
  },
  "speed_breaker": {
    "aspect_ratio_min": 4.0,
    "min_repetition_bands": 2,
    "max_spacing_pixels": 45
  }
}
